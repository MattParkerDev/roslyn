<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator</RootNamespace>
    <AssemblyName>Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplyNgenOptimization>full</ApplyNgenOptimization>
    <IsSymbolPublishingPackage>true</IsSymbolPublishingPackage>
  </PropertyGroup>
  <!--
    Optional "NuGet pack" mode, disabled by default so the repository build is unaffected.
    When enabled (-p:ExpressionEvaluatorNuGetPack=true -c Release) this project is built against the
    released Microsoft.CodeAnalysis compiler NuGet packages instead of the in-repo compiler sources,
    and packs a real (non-.Symbols) NuGet package that pairs with the released compiler.
  -->
  <PropertyGroup Condition="'$(ExpressionEvaluatorNuGetPack)' == 'true'">
    <IsSymbolPublishingPackage>false</IsSymbolPublishingPackage>
    <IsPackable>true</IsPackable>
    <IsShippingPackage>true</IsShippingPackage>
    <!-- NuGet package ID prefix. The assembly name (and thus IVT/strong-name identity) is unchanged; only the package ID is prefixed. -->
    <ExpressionEvaluatorPackageIdPrefix>MP.</ExpressionEvaluatorPackageIdPrefix>
    <PackageId>$(ExpressionEvaluatorPackageIdPrefix)$(AssemblyName)</PackageId>
    <PackageVersion>5.6.0</PackageVersion>
    <AssemblyVersion>5.6.0.0</AssemblyVersion>
    <FileVersion>5.6.0.0</FileVersion>
    <Authors>.NET Foundation and contributors</Authors>
    <Copyright></Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MattParkerDev/roslyn</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MattParkerDev/roslyn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Skip the repo's _AppendCommonPackageDescription target so no "More details at https://aka.ms/roslyn-packages"
         boilerplate is appended to the package description. -->
    <SourceControlInformationFeatureSupported>false</SourceControlInformationFeatureSupported>
    <Description>Roslyn C# debugger expression compiler (Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler), with the Microsoft.VisualStudio.Debugger.Engine (Dkm) dependency removed. Built from the Roslyn 5.6.0 source (MIT).</Description>
    <PackageDescription>Roslyn C# debugger expression compiler (Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler), with the Microsoft.VisualStudio.Debugger.Engine (Dkm) dependency removed. Built from the Roslyn 5.6.0 source (MIT).</PackageDescription>
    <PackageTags>Roslyn CodeAnalysis Compiler Debugger ExpressionEvaluator CSharp</PackageTags>
  </PropertyGroup>
  <Target Name="ValidateExpressionEvaluatorNuGetPack" BeforeTargets="Build;Pack" Condition="'$(ExpressionEvaluatorNuGetPack)' == 'true'">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="ExpressionEvaluatorNuGetPack requires a Release build (-c Release): the released Microsoft.CodeAnalysis packages are Release-built and this source only references the matching internal compiler types in Release." />
  </Target>
  <!-- Arcade's ProjectDefaults.targets forces Copyright and PackageRequireLicenseAcceptance after the project
       evaluates; re-assert the fork's values right before nuspec generation. Authors is set in the property group
       above (arcade sets it in props, which the project overrides). -->
  <Target Name="OverrideExpressionEvaluatorPackMetadata" BeforeTargets="GenerateNuspec" Condition="'$(ExpressionEvaluatorNuGetPack)' == 'true'">
    <PropertyGroup>
      <Authors>.NET Foundation and contributors</Authors>
      <Copyright></Copyright>
      <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    </PropertyGroup>
  </Target>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\..\..\Compilers\Core\Portable\Microsoft.CodeAnalysis.csproj" Condition="'$(ExpressionEvaluatorNuGetPack)' != 'true'" />
    <ProjectReference Include="..\..\..\..\Compilers\CSharp\Portable\Microsoft.CodeAnalysis.CSharp.csproj" Condition="'$(ExpressionEvaluatorNuGetPack)' != 'true'" />
    <ProjectReference Include="..\..\..\Core\Source\ExpressionCompiler\Microsoft.CodeAnalysis.ExpressionCompiler.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExpressionEvaluatorNuGetPack)' == 'true'">
    <PackageVersion Update="Microsoft.CodeAnalysis.Common" Version="5.6.0" />
    <PackageVersion Update="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.6.0" />
  </ItemGroup>
  <ItemGroup>
    <VsdConfigXmlFiles Include="CSharpExpressionCompiler.vsdconfigxml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.CSharp.ExpressionEvaluator.ExpressionCompiler.UnitTests" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.ProductionBreakpoints.CodeAnalysis" Key="$(VisualStudioDebuggerKey)" WorkItem="https://github.com/dotnet/roslyn/issues/35084" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <Import Project="$(RepositoryEngineeringDir)targets\Vsdconfig.targets" />
</Project>